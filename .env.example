# Backend environment variables. Copy to .env (never commit .env).
PORT=3000
NODE_ENV=development
DATABASE_URL=postgres://user:password@localhost:5432/tikosorted

# Auth
JWT_SECRET=change-me
JWT_EXPIRES_IN=8h
ARTIST_TOKEN_SECRET=change-me-too
TICKET_SIGNING_SECRET=change-me-as-well
# Dev only. Ignored when NODE_ENV=production. Never enable on a deployed server.
BYPASS_AUTH=false

# Booking
HOLD_TTL_SECONDS=600

# M-Pesa Daraja (callback URL must be public HTTPS)
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_BASE_URL=https://sandbox.safaricom.co.ke
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://your-public-host/api/payments/mpesa/callback
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline

# Email (SMTP)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_SECURE=false
MAIL_FROM=
APP_NAME=TikoSorted

# Links in emails
FRONTEND_URL=http://localhost:5173
